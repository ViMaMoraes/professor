{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "professor",
  // worker.ts = o site (.open-next/worker.js, gerado no build) + as tarefas agendadas abaixo
  "main": "worker.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      // referência ao próprio worker, usada pelo OpenNext (o nome precisa ser igual a "name")
      "binding": "WORKER_SELF_REFERENCE",
      "service": "professor"
    }
  ],
  "d1_databases": [
    {
      // banco SQLite da Cloudflare (D1). As tabelas são criadas pelas migrações em drizzle/
      "binding": "DB",
      "database_name": "professor-db",
      "database_id": "07723695-b1b8-4ee4-9cbb-25f3106a4923",
      "migrations_dir": "drizzle"
    }
  ],
  // endereço oficial: os links que o professor copia e envia (acesso do aluno, dados de um professor novo)
  // usam sempre este endereço, mesmo acessando pelo workers.dev
  "vars": {
    "ENDERECO_SITE": "https://professor.mmoraes.com.br"
  },
  // não apaga as variáveis criadas pelo painel da Cloudflare (ex.: VAPID_CONTATO) a cada deploy
  "keep_vars": true,
  // todo dia às 8h17 (Brasília): aviso de vencimento dos professores ao master
  "triggers": {
    "crons": ["17 11 * * *"]
  },
  "observability": {
    "enabled": true
  }
}
