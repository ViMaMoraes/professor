{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "professor",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      // referência ao próprio worker, usada pelo OpenNext (o nome precisa ser igual a "name")
      "binding": "WORKER_SELF_REFERENCE",
      "service": "professor"
    }
  ],
  "d1_databases": [
    {
      // banco SQLite da Cloudflare (D1). As tabelas são criadas pelas migrações em drizzle/
      "binding": "DB",
      "database_name": "professor-db",
      "database_id": "07723695-b1b8-4ee4-9cbb-25f3106a4923",
      "migrations_dir": "drizzle"
    }
  ],
  "observability": {
    "enabled": true
  }
}
